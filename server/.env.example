NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/content_hub?schema=public"
# Requires development environment and a local database host.
ALLOW_DEV_SEED=false
# Replace with 32 random bytes encoded as base64url. No default secret is accepted.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64URL_VALUE
SESSION_HOURS=24
SESSION_IDLE_MINUTES=30
# Production always requires Secure cookies and HTTPS origins.
SESSION_COOKIE_SECURE=false
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Separate from SESSION_SECRET. Required to save API keys: 32 random bytes as base64url.
# PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64URL_VALUE
